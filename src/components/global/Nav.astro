---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import wordmark from "@/assets/icons/logo-onelisted.svg";
import chevron from "@/assets/icons/chevron-down.svg";
import search from "@/assets/icons/search.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const menu = [
  { label: "Articles", href: "/articles", menu: true },
  { label: "Guides", href: "/guides", menu: true },
  { label: "Neighborhood", href: "/neighborhoods", menu: true },
  { label: "Condos", href: "/condos", menu: true },
  { label: "Videos", href: "/videos", menu: false },
  { label: "About", href: "/about", menu: false },
];
---

{
  render && (
    <header class:list={["nav_wrap", "theme-dark", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={wordmark} variant="full-width" />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              {menu.map((item) => (
                <li>
                  <a class="nav_link" href={item.href}>
                    {item.label}
                    {item.menu && (
                      <Icon src={chevron} variant="xs" aria-hidden="true" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
            <div class="nav_actions">
              <a class="nav_search" href="/search" aria-label="Search">
                <Icon src={search} variant="m" />
              </a>
              <Button element="link" href="/contact" emphasis="secondary">
                Enquire now
              </Button>
            </div>
          </div>
        </nav>
        <div class="nav_desktop_actions">
          <a class="nav_search" href="/search" aria-label="Search">
            <Icon src={search} variant="m" />
          </a>
          <Button element="link" href="/contact" emphasis="secondary">
            Enquire now
          </Button>
        </div>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-content);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-2-5rem);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 9rem;
      :is(svg, path) {
        fill: currentcolor;
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-0-5rem);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-0-75rem) var(--site-margin) var(--space-1-5rem);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
    }

    .nav_link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-0-5rem);
      padding-block: var(--space-1rem);
      color: var(--text);
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_actions {
      display: flex;
      align-items: center;
      gap: var(--space-1-5rem);
      padding: 0 var(--site-margin) var(--space-1-5rem);
    }

    .nav_desktop_actions {
      display: none;
    }

    .nav_search {
      display: inline-flex;
      color: var(--text);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
      }

      .nav_menu_inner {
        display: contents;
        overflow: visible;
        opacity: 1;
      }

      .nav_actions {
        display: none;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: var(--space-0-125rem);
        font-size: var(--text-main);
      }

      .nav_link {
        padding: var(--space-0-75rem) var(--space-1rem);
      }

      .nav_desktop_actions {
        display: flex;
        align-items: center;
        gap: var(--space-1-5rem);
      }
    }
  }
</style>
